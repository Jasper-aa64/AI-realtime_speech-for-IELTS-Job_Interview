# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real keys.

# AI HTTP provider (OpenAI-compatible endpoint)
AI_HTTP_BASE_URL=https://api.openai.com/v1
AI_HTTP_API_KEY=sk-your-key-here
AI_HTTP_MODEL=gpt-5.4-mini
AI_HTTP_TIMEOUT_SECONDS=30

# Speaking AI routing
SPEAKING_AI_CALL_MODE=chain
SPEAKING_AI_MODEL=gpt-5.4-mini

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,psi-linagjm.tail46b1c.ts.net
DJANGO_CSRF_TRUSTED_ORIGINS=https://psi-linagjm.tail46b1c.ts.net

# Optional: VolcEngine ASR (realtime capture and late-audio report recovery)
# VOLCENGINE_ASR_ENABLED=0
# VOLCENGINE_ASR_APP_ID=
# VOLCENGINE_ASR_ACCESS_KEY=
# VOLCENGINE_ASR_APP_KEY=
# VOLCENGINE_ASR_FFMPEG=ffmpeg
